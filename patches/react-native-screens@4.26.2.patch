+- (void)rebakeUnselectedSymbolsForTabScreenControllers:
+    (nullable NSArray<RNSTabsScreenViewController *> *)tabScreenCtrls
+{
+  if (tabScreenCtrls == nil) {
+    return;
+  }
+
+  for (RNSTabsScreenViewController *tabScreenCtrl in tabScreenCtrls) {
+    if (tabScreenCtrl == nil) {
+      continue;
+    }
+
+    RNSTabsScreenComponentView *screenView = tabScreenCtrl.tabScreenComponentView;
+    if (screenView.iconType != RNSTabsIconTypeSfSymbol || screenView.iconResourceName == nil) {
+      continue;
+    }
+
+    UITabBarItem *tabBarItem = tabScreenCtrl.tabBarItem;
+    if (tabBarItem.image.renderingMode == UIImageRenderingModeAlwaysOriginal) {
+      continue;
+    }
+
+    UIImage *image = RNSUnselectedTabSymbolImage(screenView.iconResourceName, tabBarItem);
+    if (image != nil && image.renderingMode == UIImageRenderingModeAlwaysOriginal) {
+      tabBarItem.image = image;
+    }
+  }
+}
