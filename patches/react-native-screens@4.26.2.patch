+- (void)viewDidLayoutSubviews
+{
+  [super viewDidLayoutSubviews];
+
+  // UIKit can replace tab images during layout on iOS 26. Re-bake only when the
+  // unselected symbol is no longer AlwaysOriginal, and ignore the layout that
+  // assigning the image itself schedules.
+  if (_isRebakingUnselectedSymbols || _tabScreenControllers == nil) {
+    return;
+  }
+
+  _isRebakingUnselectedSymbols = YES;
+  [_tabBarAppearanceCoordinator rebakeUnselectedSymbolsForTabScreenControllers:_tabScreenControllers];
+  _isRebakingUnselectedSymbols = NO;
+}
