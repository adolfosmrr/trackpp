+// iOS 26 liquid glass ignores normal.iconColor on template SF Symbols.
+// A pre-tinted AlwaysOriginal image keeps the requested color. The selected
+// image stays a template so tabBar.tintColor still paints the active tab.
+static UIImage *_Nullable RNSUnselectedTabSymbolImage(NSString *name, UITabBarItem *tabBarItem)
+{
+  UIImage *symbol = [UIImage systemImageNamed:name];
+  if (symbol == nil) {
+    return nil;
+  }
+
+  if (@available(iOS 26.0, *)) {
+    UIColor *iconColor = tabBarItem.standardAppearance.stackedLayoutAppearance.normal.iconColor;
+    if (iconColor != nil) {
+      return [symbol imageWithTintColor:iconColor renderingMode:UIImageRenderingModeAlwaysOriginal];
+    }
+  }
+
+  return symbol;
+}
